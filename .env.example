# ─── SUPABASE (create a FRESH project for this platform) ─────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_or_publishable_key"
# Server-side only. Used by scripts/test-rls.ts (seeding) and future API routes.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_or_secret_key"

# ─── APP ──────────────────────────────────────────────────────────────────────
# Public origin of THIS platform (magic-link redirects). Local default:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── PAYMENTS (Route A: Stripe, test mode first — brief §5) ──────────────────
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # webhook endpoint: /api/payments/webhook

# ─── TRACKING ────────────────────────────────────────────────────────────────
COLLECT_IP_SALT="change-me-rotating-salt"   # raw IPs are never stored

# ─── SURVEY ──────────────────────────────────────────────────────────────────
# Optional shared secret the Framer webhook must send as `x-survey-secret`.
# SURVEY_WEBHOOK_SECRET=""

# ─── LATER ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=""               # invoice notices / transactional email
